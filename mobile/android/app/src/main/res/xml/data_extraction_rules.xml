<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device-to-device transfer must never carry device secrets or metadata. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="connections.enc" />
        <exclude
            domain="file"
            path="devices.json" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="connections.enc" />
        <exclude
            domain="file"
            path="devices.json" />
    </device-transfer>
</data-extraction-rules>
