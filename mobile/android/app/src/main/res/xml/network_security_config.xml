<?xml version="1.0" encoding="utf-8"?>
<!-- Trust only the system CA store: user-installed CAs are rejected, cleartext is disabled. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
