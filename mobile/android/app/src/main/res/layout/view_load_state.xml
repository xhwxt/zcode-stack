<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/load_state_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Mutually exclusive: spinner while connecting, brand mark when failed.
         Both occupy the same 56dp slot so the switch never reflows the text. -->
    <FrameLayout
        android:id="@+id/load_state_indicator_slot"
        android:layout_width="56dp"
        android:layout_height="56dp">

        <ProgressBar
            android:id="@+id/load_state_spinner"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <ImageView
            android:id="@+id/load_state_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_brand"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/load_state_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:text="@string/connecting_title"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/load_state_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:text="@string/connecting_detail"
        android:textSize="14sp" />

    <!-- Buttons keep their slot and meaning across loading/failed/revoked:
         primary = device list, secondary = retry (or pairing on the revoked
         screen). -->
    <Button
        android:id="@+id/load_state_primary"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="26dp"
        android:stateListAnimator="@null"
        android:text="@string/connecting_open_devices"
        android:textSize="15sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/load_state_secondary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:stateListAnimator="@null"
        android:text="@string/error_page_retry"
        android:textSize="14sp" />
</LinearLayout>
