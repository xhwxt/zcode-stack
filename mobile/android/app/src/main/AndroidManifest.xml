<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- WebView 加载网页必需；缺失时页面统一报 net::ERR_CACHE_MISS。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Task notifications: the page's own notification call has no Web
         Notifications API in WebView, so the shell posts it natively. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep-alive foreground service: holds the process (and with it the
         page → shim → shell notification chain) while the user expects task
         notifications. DATA_SYNC covers API 29-33; SPECIAL_USE is the
         targetSdk 34+ declaration for a user-facing keep-alive that fits no
         other listed type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Re-arm the keep-alive service after a reboot (default: enabled). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Battery-optimization exemption: lets the user (via the system dialog the
         shell raises) keep the keep-alive probe loop alive on aggressive ROMs
         (vivo 等) that would otherwise freeze or kill the background process.
         The dialog is only ever opened from a visible screen and can be
         declined; without the declaration the request intent would be refused.
         Personal distribution only — never appropriate for store listings. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ZCode">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|screenLayout|smallestScreenSize|uiMode|density|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keep-alive foreground service; never exported, started by the shell
             and re-armed by the boot receiver. -->
        <service
            android:name=".ZcodeKeepaliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the ZCode shell process alive so task notifications can be delivered while the app is in the background." />
        </service>

        <receiver
            android:name=".ZcodeKeepaliveService$KeepaliveStopReceiver"
            android:exported="false" />

        <receiver
            android:name=".ZcodeBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
